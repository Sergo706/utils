{
  "name": "@riavzon/utils",
  "version": "1.2.0",
  "author": "Sergio contact@riavzon.com",
  "license": "MIT",
  "type": "module",
  "main": "./dist/main.mjs",
  "types": "./dist/main.d.mts",
  "description": "Collection of generic/advanced TypeScript utilities and ESLint configs",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sergo706/utils"
  },
  "homepage": "https://docs.riavzon.com/docs/utils",
  "bugs": {
    "url": "https://github.com/Sergo706/utils/issues"
  },
  "keywords": [
    "utilities",
    "utils",
    "eslint configs",
    "geoip",
    "geolocation",
    "debounce",
    "batch queue",
    "configuration definer",
    "mini cache",
    "promise locker",
    "deduplication"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/main.d.mts",
        "default": "./dist/main.mjs"
      },
      "require": {
        "types": "./dist/main.d.cts",
        "default": "./dist/main.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.mts",
        "default": "./dist/server.mjs"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./eslint/strict": {
      "import": {
        "types": "./dist/eslint/strict.d.mts",
        "default": "./dist/eslint/strict.mjs"
      },
      "require": {
        "types": "./dist/eslint/strict.d.cts",
        "default": "./dist/eslint/strict.cjs"
      }
    },
    "./eslint/strict/vue": {
      "import": {
        "types": "./dist/eslint/strict/vue.d.mts",
        "default": "./dist/eslint/strict/vue.mjs"
      },
      "require": {
        "types": "./dist/eslint/strict/vue.d.cts",
        "default": "./dist/eslint/strict/vue.cjs"
      }
    },
    "./eslint/strict/react": {
      "import": {
        "types": "./dist/eslint/strict/react.d.mts",
        "default": "./dist/eslint/strict/react.mjs"
      },
      "require": {
        "types": "./dist/eslint/strict/react.d.cts",
        "default": "./dist/eslint/strict/react.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "server": [
        "./dist/server.d.mts"
      ],
      "eslint/strict": [
        "./dist/eslint/strict.d.mts"
      ],
      "eslint/strict/vue": [
        "./dist/eslint/strict/vue.d.mts"
      ],
      "eslint/strict/react": [
        "./dist/eslint/strict/react.d.mts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "eslint .",
    "test": "npx tsx --test tests/*.test.ts",
    "prepublishOnly": "npm run build",
    "docs:build": "typedoc --options ./typedoc.json"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.2",
    "@types/node": "^25.2.0",
    "@types/pg": "^8.18.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.6",
    "eslint-plugin-vue": "^10.7.0",
    "jiti": "^2.6.1",
    "mysql2": "^3.17.2",
    "pg": "^8.20.0",
    "pino": "^10.3.0",
    "publint": "^0.3.18",
    "tsdown": "^0.21.4",
    "typedoc": "^0.28.18",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "peerDependencies": {
    "pino": ">=8.0.0"
  }
}
